{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "animaku",
  "main": "./apps/server/src/worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Keep APIs ahead of SPA fallback, and brand HTML using D1 before Assets
    // responds. Static JS/images do not need Worker execution or a D1 lookup.
    "run_worker_first": ["/api/*", "/", "/index.html", "/subject/*", "/play/*", "/anime", "/timeline", "/search", "/collect", "/history", "/settings", "/offline", "/account", "/admin"]
  },
  // Dashboard owns runtime variables and storage bindings. keep_vars alone
  // only retains plain_text/json; without keep_bindings a deploy removes D1.
  // unsafe.metadata passes the documented API option through Wrangler, so
  // include the variable/secret types as well as the storage types it retains.
  "unsafe": {
    "metadata": {
      "keep_bindings": [
        "plain_text",
        "json",
        "secret_text",
        "secret_key",
        "d1",
        "r2_bucket",
        "kv_namespace"
      ]
    }
  }
}
