{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "animaku",
  "main": "./apps/server/src/worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // HTML needs D1 branding before Assets responds. Static JS, images and
    // offline media remain on their existing paths without a D1 lookup.
    "run_worker_first": ["/", "/index.html", "/subject/*", "/play/*", "/anime", "/timeline", "/search", "/collect", "/history", "/settings", "/offline", "/account", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "animaku",
      "database_id": "3c63301c-f370-4a1a-9a1a-223c9a81ff66",
      "migrations_dir": "./apps/server/migrations"
    }
  ],
  "vars": {
    "APP_VERSION": "1.19.2",
    "UPSTREAM_PROXY_URL": "https://animaku-egress-proxy.vercel.app",
    "ACCOUNT_REGISTRATION_ENABLED": "true",
    "ADMIN_USERNAME": "admin"
    // Set ADMIN_USERNAME in Cloudflare Worker Variables to the account that
    // should receive automatic administrator access. Store ADMIN_PASSWORD
    // with `wrangler secret put ADMIN_PASSWORD`; never commit the password.
  }
}
