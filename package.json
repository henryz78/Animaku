{
  "name": "animaku",
  "private": true,
  "version": "1.19.2",
  "description": "Animaku — browser anime client: Bangumi metadata, plugin sources, danmaku, collections",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @animaku/web dev",
    "dev:server": "pnpm --filter @animaku/server dev",
    "dev:parallel": "pnpm -r --parallel --filter @animaku/web --filter @animaku/server dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @animaku/web build",
    "build:server": "pnpm --filter @animaku/server build",
    "build:cloudflare": "pnpm typecheck && pnpm build:web",
    "check:cloudflare": "wrangler deploy --config wrangler.jsonc --keep-vars --dry-run",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc --keep-vars",
    "start": "pnpm --filter @animaku/server start",
    "start:prod": "pnpm build && pnpm start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:sources": "pnpm --filter @animaku/server exec tsx ../../scripts/test-sources.ts",
    "benchmark:sources": "pnpm --filter @animaku/server exec tsx ../../scripts/benchmark-sources.mjs",
    "db": "node scripts/db-query.mjs",
    "db:migrate": "node scripts/migrate-play-stats.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
